{"id":"fp","type":"function","name":"Parse","outputs":14,"func":"var r=msg.payload;\nif(!r||r.length<28)return Array(14).fill(null);\nvar d={hr0:r[0],hr1:r[1],hr2:r[2],hr3:r[3],freq:r[4]/100,minV:r[5]/1000,simH:Math.floor(r[6]/100),simM:r[6]%100,alarm:r[7],v_sub:r[8]/1000,v_ind:r[9]/1000,v_res:r[10]/1000,v_com:r[11]/1000,totalKW:r[12],lossKW:r[13]/10,solarKW:r[14]/10,latency:r[15]/100,T_oil:r[16]/10,T_hs:r[17]/10,T_amb:r[18]/10,cooling:r[19],SoC:r[20],T_batt:r[21]/10,irrad:r[22],wind:r[23]/10,prot:r[24],aging:r[25]/100,SoH:r[26],cloud:r[27]};\nreturn[\n{payload:d.freq},\n{payload:d.minV},\n{payload:d.totalKW},\n{payload:d.solarKW},\n{payload:d.T_amb},\n{payload:d.irrad},\n{payload:d.wind},\n{payload:d.T_oil},\n{payload:d.T_hs},\n{payload:d.SoC},\n{payload:d.SoH},\n{payload:d.T_batt},\n{payload:d},\n{payload:d}\n];","x":280,"y":80,"wires":[["ga1"],["ga2"],["ga3"],["ga4"],["ga5"],["ga6"],["ga7"],["ga8"],["ga9"],["ga10"],["ga11"],["ga12"],["tp1","tp2","tp3","tp4","tp5"],["fv","ft","fen","influx_fmt","csv_fmt"]]},

