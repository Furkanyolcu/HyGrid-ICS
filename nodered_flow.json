{"id":"influx_fmt","type":"function","name":"InfluxDB Fmt","outputs":1,"func":"var d=msg.payload;\nmsg.payload={HR0_load_shed:d.hr0,HR1_capacitor:d.hr1,HR2_solar:d.hr2,HR3_battery:d.hr3,frequency_hz:d.freq,min_voltage:d.minV,total_kw:d.totalKW,solar_kw:d.solarKW,losses_kw:d.lossKW,latency_ms:d.latency,alarm:d.alarm,v_sub:d.v_sub,v_ind:d.v_ind,v_res:d.v_res,v_com:d.v_com,T_oil:d.T_oil,T_hotspot:d.T_hs,T_ambient:d.T_amb,cooling_mode:d.cooling,SoC:d.SoC,SoH:d.SoH,T_battery:d.T_batt,irradiance:d.irrad,wind_speed:d.wind,prot_bitmask:d.prot,aging_rate:d.aging,cloud_pct:d.cloud,sim_hour:d.simH,sim_min:d.simM};\nreturn msg;","x":680,"y":310,"wires":[["influx_out"]]},

