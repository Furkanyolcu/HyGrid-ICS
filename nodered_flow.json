{"id":"csv_fmt","type":"function","name":"CSV Fmt","outputs":1,"func":"var d=msg.payload;\nvar init=flow.get('csv_init')||false;\nvar hdr='real_timestamp,sim_time,HR0,HR1,HR2,HR3,freq_hz,min_voltage,total_kw,solar_kw,losses_kw,latency_ms,alarm,v_sub,v_ind,v_res,v_com,T_oil,T_hotspot,T_ambient,cooling_mode,SoC,SoH,T_battery,irradiance,wind_speed,prot_bitmask,aging_rate,cloud_pct';\nvar now=new Date();\nvar ts=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0')+'T'+String(now.getHours()).padStart(2,'0')+':'+String(now.getMinutes()).padStart(2,'0')+':'+String(now.getSeconds()).padStart(2,'0')+'.'+String(now.getMilliseconds()).padStart(3,'0');\nvar st=d.simH+':'+(d.simM<10?'0':'')+d.simM;\nvar row=ts+','+st+','+d.hr0+','+d.hr1+','+d.hr2+','+d.hr3+','+d.freq+','+d.minV+','+d.totalKW+','+d.solarKW+','+d.lossKW+','+d.latency+','+d.alarm+','+d.v_sub+','+d.v_ind+','+d.v_res+','+d.v_com+','+d.T_oil+','+d.T_hs+','+d.T_amb+','+d.cooling+','+d.SoC+','+d.SoH+','+d.T_batt+','+d.irrad+','+d.wind+','+d.prot+','+d.aging+','+d.cloud;\nif(!init){msg.payload=hdr+'\\n'+row+'\\n';flow.set('csv_init',true);}else{msg.payload=row+'\\n';}\nreturn msg;","x":680,"y":350,"wires":[["csv_file"]]},

