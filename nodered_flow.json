{"id":"tp1","type":"ui_template","group":"g1f","name":"System","order":1,"width":"4","height":"8","format":"<style>.si .r{display:flex;justify-content:space-between;padding:6px 2px;border-bottom:1px solid #eee;font-size:13px}.si .k{color:#607d8b}.si .v{font-weight:700}</style><div class='si'><div class='r'><span class='k'>Sim Time</span><span class='v'>{{msg.payload.simH}}:{{msg.payload.simM<10?'0'+msg.payload.simM:msg.payload.simM}}</span></div><div class='r'><span class='k'>Load</span><span class='v'>{{msg.payload.totalKW}} kW</span></div><div class='r'><span class='k'>☀️ Solar</span><span class='v' style='color:#e65100'>{{msg.payload.solarKW.toFixed(1)}} kW</span></div><div class='r'><span class='k'>Losses</span><span class='v'>{{msg.payload.lossKW.toFixed(1)}} kW</span></div><div class='r'><span class='k'>📡 Latency</span><span class='v' style='color:#1565c0'>{{msg.payload.latency.toFixed(2)}} ms</span></div><div class='r'><span class='k'>🚨 Alarm</span><span class='v' ng-style=\"{'color':msg.payload.alarm?'#c62828':'#2e7d32'}\">{{msg.payload.alarm?'🔴 ALARM':'CLEAR'}}</span></div><div class='r'><span class='k'>HR0 Load</span><span class='v'>{{msg.payload.hr0?'CUT':'Normal'}}</span></div><div class='r'><span class='k'>HR1 Cap</span><span class='v'>{{msg.payload.hr1?'ON':'OFF'}}</span></div><div class='r'><span class='k'>HR2 Solar</span><span class='v'>%{{msg.payload.hr2}}</span></div><div class='r'><span class='k'>HR3 Batt</span><span class='v'>{{['Standby','Discharge','Charge'][msg.payload.hr3]}}</span></div></div>","x":680,"y":20,"wires":[[]]},

{"id":"tp2","type":"ui_template","group":"g1e","name":"Buses","order":1,"width":"8","height":"5","format":"<style>.vb{display:flex;gap:12px;padding:6px}.vb .bi{flex:1;text-align:center}.vb .bo{background:#eceff1;border-radius:8px;height:115px;position:relative;overflow:hidden}.vb .bf{position:absolute;bottom:0;width:100%;border-radius:0 0 8px 8px;transition:height .5s}.vb .bv{position:absolute;top:8px;width:100%;text-align:center;font-size:14px;font-weight:800;z-index:1}.vb .bl{font-size:11px;color:#607d8b;margin-top:4px;font-weight:600}.vb .dl{position:absolute;bottom:55%;width:100%;border-top:2px dashed #e53935;z-index:2}</style><div class='vb'><div class='bi' ng-repeat=\"b in [{n:'Substation',v:msg.payload.v_sub},{n:'Industrial',v:msg.payload.v_ind},{n:'Residential',v:msg.payload.v_res},{n:'Commercial',v:msg.payload.v_com}]\"><div class='bo'><div class='dl'></div><div class='bf' ng-style=\"{'height':(b.v*100)+'%','background':b.v<0.90?'#e53935':b.v<0.95?'#fb8c00':'#43a047'}\"></div><div class='bv'>{{b.v.toFixed(3)}}</div></div><div class='bl'>{{b.n}}</div></div></div>","x":680,"y":50,"wires":[[]]},

{"id":"tp3","type":"ui_template","group":"g2d","name":"Weather Detail","order":1,"width":"3","height":"3","format":"<style>.hd .r{display:flex;justify-content:space-between;padding:5px 2px;border-bottom:1px solid #eee;font-size:12px}.hd .k{color:#607d8b}.hd .v{font-weight:700}</style><div class='hd'><div class='r'><span class='k'>Cloud</span><span class='v' ng-style=\"{'color':msg.payload.cloud>50?'#e65100':'#333'}\">%{{msg.payload.cloud}}</span></div><div class='r'><span class='k'>Humidity</span><span class='v'>~{{45+Math.round(msg.payload.T_amb*0.5)}}%</span></div></div>","x":680,"y":80,"wires":[[]]},

{"id":"tp4","type":"ui_template","group":"g2g","name":"Transformer Detail","order":1,"width":"6","height":"3","format":"<style>.td .r{display:flex;justify-content:space-between;padding:6px 2px;border-bottom:1px solid #eee;font-size:13px}.td .k{color:#607d8b}.td .v{font-weight:700}</style><div class='td'><div class='r'><span class='k'>Cooling Mode</span><span class='v'>{{msg.payload.cooling===1?'ONAF (Fans)':'ONAN (Natural)'}}</span></div><div class='r'><span class='k'>Aging Rate</span><span class='v' ng-style=\"{'color':msg.payload.aging>2?'#c62828':msg.payload.aging>1.5?'#e65100':'#2e7d32'}\">{{msg.payload.aging.toFixed(3)}}x</span></div><div class='r'><span class='k'>Transformer Alarm</span><span class='v' ng-style=\"{'color':msg.payload.T_hs>105?'#c62828':'#2e7d32'}\">{{msg.payload.T_hs>120?'EMERGENCY':msg.payload.T_hs>105?'WARNING':'🟢 Normal'}}</span></div></div>","x":680,"y":110,"wires":[[]]},

{"id":"tp5","type":"ui_template","group":"g3d","name":"Batt Detail","order":1,"width":"6","height":"5","format":"<style>.bd .r{display:flex;justify-content:space-between;padding:6px 2px;border-bottom:1px solid #eee;font-size:13px}.bd .k{color:#607d8b}.bd .v{font-weight:700}</style><div class='bd'><div class='r'><span class='k'>🔋 SoC</span><span class='v' ng-style=\"{'color':msg.payload.SoC<15?'#c62828':msg.payload.SoC<30?'#e65100':'#2e7d32'}\">%{{msg.payload.SoC}}</span></div><div class='r'><span class='k'>💚 SoH</span><span class='v'>%{{msg.payload.SoH}}</span></div><div class='r'><span class='k'>Cell °C</span><span class='v' ng-style=\"{'color':msg.payload.T_batt>45?'#c62828':'#333'}\">{{msg.payload.T_batt.toFixed(1)}}°C</span></div><div class='r'><span class='k'>Mode</span><span class='v'>{{['Standby','Discharge','Charge'][msg.payload.hr3]||'?'}}</span></div><div class='r'><span class='k'>Protection</span><span class='v' ng-style=\"{'color':msg.payload.SoC<=10?'#e65100':'#2e7d32'}\">{{msg.payload.SoC<=10?'ACTIVE':'✅ Normal'}}</span></div></div>","x":680,"y":140,"wires":[[]]},

{"id":"tp6","type":"ui_template","group":"g4a","name":"Relay","order":1,"width":"12","height":"5","format":"<style>.pr .g{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;padding:6px}.pr .c{padding:10px 4px;border-radius:8px;text-align:center;font-size:11px;font-weight:700;line-height:1.3;border:2px solid transparent}.pr .on{background:#ffebee;color:#c62828;border-color:#ef5350;animation:pb 1s infinite}.pr .off{background:#f5f5f5;color:#bdbdbd;border-color:#e0e0e0}@keyframes pb{50%{opacity:.5}}.pr .m{text-align:center;color:#9e9e9e;font-size:11px;margin-top:6px}</style><div class='pr'><div class='g'><div ng-class=\"(msg.payload.prot&64)?'c on':'c off'\">UFLS-1<br><small>f&lt;49.5Hz</small><br><small>Industrial 30%</small></div><div ng-class=\"(msg.payload.prot&128)?'c on':'c off'\">UFLS-2<br><small>f&lt;49.3Hz</small><br><small>Cut Residential</small></div><div ng-class=\"(msg.payload.prot&256)?'c on':'c off'\">UFLS-3<br><small>f&lt;49.0Hz</small><br><small>Commercial 50%</small></div><div ng-class=\"(msg.payload.prot&1)?'c on':'c off'\">27-UV<br><small>V&lt;0.95</small></div><div ng-class=\"(msg.payload.prot&2)?'c on':'c off'\">27-Shed<br><small>V&lt;0.92</small></div><div ng-class=\"(msg.payload.prot&4)?'c on':'c off'\">27-EMERGENCY<br><small>V&lt;0.88</small></div><div ng-class=\"(msg.payload.prot&8)?'c on':'c off'\">59-OV<br><small>V&gt;1.05</small></div><div ng-class=\"(msg.payload.prot&16)?'c on':'c off'\">59-EMERGENCY<br><small>V&gt;1.10</small></div><div ng-class=\"(msg.payload.prot&32)?'c on':'c off'\">81O<br><small>f&gt;50.5Hz</small></div><div ng-class=\"(msg.payload.prot&512)?'c on':'c off'\">49-Termal<br><small>T&gt;105°C</small></div></div><div class='m'>Bitmask: {{msg.payload.prot}} (0b{{msg.payload.prot.toString(2).padStart(10,'0')}})</div></div>","x":680,"y":170,"wires":[[]]},

